{
  "name": "data-chord",
  "version": "1.0.0",
  "description": "Data harmonization workflow with Bedrock CDE recommendations and agentic value harmonization.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --import ./tests/js/register-assets.js --test tests/js/*.test.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "perf:e2e": "RUN_PERF=true playwright test tests/e2e/performance.e2e.spec.mjs --reporter=line",
    "perf:virtual-table": "RUN_VIRTUAL_TABLE_PERF=true playwright test tests/e2e/virtual-table.performance.spec.mjs --reporter=line",
    "perf:staging": "RUN_REMOTE_PERF=true PLAYWRIGHT_NO_WEBSERVER=true playwright test tests/e2e/performance.remote.e2e.spec.mjs --reporter=line"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=24.5.0",
    "npm": ">=11.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
