# =============================================================================
# Data Chord Environment Configuration
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# The app loads this file at startup. Existing shell variables take precedence.
# =============================================================================

# Local development uses one shared workflow owner. Deployed hosted services
# must use trusted_proxy or signed_alb instead.
DEV_MODE=true
DATA_CHORD_IDENTITY_SOURCE=shared

# Portable container profile. Standards are loaded into
# DATA_CHORD_DATA_DIR/standards.sqlite before application startup.
# DATA_CHORD_PROFILE=portable
# DATA_CHORD_DATA_DIR=/data

# Workflow storage uses local directories by default.
DATA_CHORD_STORAGE=local
# Optional local path overrides. Relative paths start at the repository root.
# DATA_CHORD_UPLOAD_DIR=uploads
# DATA_CHORD_WORKFLOW_STORAGE_DIR=workflow_storage

# OpenTofu-managed deployments set these values. To test S3 locally, change
# DATA_CHORD_STORAGE above to s3 and set the bucket and optional prefix.
# DATA_CHORD_S3_BUCKET=data-chord-staging-workflow-123456789012-us-east-2
# DATA_CHORD_S3_PREFIX=

# Dedicated DynamoDB table populated by scripts/reference_data.py.
DATA_CHORD_REFERENCE_TABLE=data-chord-local-reference-data
# Derived data. These tables can start empty.
DATA_CHORD_CDE_RECOMMENDATION_CACHE_TABLE=data-chord-local-cde-recommendation-cache
DATA_CHORD_HARMONIZATION_CACHE_TABLE=data-chord-local-harmonization-cache
DATA_CHORD_AGENTIC_WORKERS=100
AWS_REGION=us-east-2

# OpenTofu sets this to pin signed identity tokens to the deployed load
# balancer. Leave it unset for normal local development.
# DATA_CHORD_ALB_ARN=arn:aws:elasticloadbalancing:us-east-2:123456789012:loadbalancer/app/example/1234567890abcdef
