# =============================================================================
# Data Chord Environment Configuration
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# The .env file is loaded at app startup. Shell env vars take precedence.
# =============================================================================

# Netrias API key for CDE discovery and Data Model Store access.
# Contact Netrias for access.
NETRIAS_API_KEY=your_api_key_here

# Agentic harmonization is the default. Set netrias only for a client that still
# uses the legacy remote harmonizer.
DATA_CHORD_HARMONIZER=agentic
DATA_CHORD_AGENTIC_WORKERS=50
AWS_REGION=us-east-2
