# =============================================================================
# Data Chord Environment Configuration
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# The .env file is loaded at app startup. Shell env vars take precedence.
# =============================================================================

# Dedicated DynamoDB table populated by scripts/reference_data.py.
DATA_CHORD_REFERENCE_TABLE=data-chord-local-reference-data
DATA_CHORD_AGENTIC_WORKERS=50
AWS_REGION=us-east-2
